{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_ANTICHEAT_BLOCK": "1",
    "CLAUDE_EVAL_FIRST_BLOCK": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch*)",
      "Bash(npm run check*)",
      "Bash(npx astro check*)",
      "Bash(bash validate-graph*)",
      "Bash(bash audit-*)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Skill(arena)",
      "Skill(audit-project)",
      "Skill(automate-me)",
      "Skill(connect)",
      "Skill(learn-book)",
      "Skill(level-up)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "fallbackModel": [
    "claude-opus-5",
    "claude-sonnet-5-5"
  ],
  "skillOverrides": {
    "catchup": "user-invocable-only",
    "hook-review": "user-invocable-only",
    "prune-memory": "user-invocable-only",
    "skill-audit": "user-invocable-only",
    "telemetry": "user-invocable-only",
    "audit-project": "off",
    "publish-stack": "user-invocable-only",
    "careful": "user-invocable-only",
    "freeze": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-liveness-sessionstart.sh\"",
            "timeout": 15000
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(uname)\" = \"Darwin\" ]; then afplay /System/Library/Sounds/Glass.aiff; elif command -v powershell >/dev/null 2>&1; then powershell -c '[Console]::Beep(800, 300)'; fi",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'File modified \u2014 remember to run relevant check commands before committing'",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/session-manifest.js\" record",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(uname)\" = \"Darwin\" ]; then afplay /System/Library/Sounds/Pop.aiff; elif command -v powershell >/dev/null 2>&1; then powershell -c '[Console]::Beep(600, 200)'; fi && echo 'Turn complete. Check status line for context usage.'",
            "timeout": 5000
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(uname)\" = \"Darwin\" ]; then afplay /System/Library/Sounds/Sosumi.aiff; elif command -v powershell >/dev/null 2>&1; then powershell -c '[Console]::Beep(400, 500)'; fi && echo 'API error \u2014 rate limited or auth failure. Wait before retrying. Check status line for rate limit usage.'",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/precompact-guard.js\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let r='';try{if(!process.stdin.isTTY)r=require('fs').readFileSync(0,'utf8')}catch(e){};if(!r.trim()&&process.env.CLAUDE_TOOL_INPUT)r=process.env.CLAUDE_TOOL_INPUT;let p={};try{p=r.trim()?JSON.parse(r):{}}catch(e){};const c=(p.tool_input&&p.tool_input.command)||p.command||'';if(c.includes('git push')){process.stdout.write('WARN: About to push to remote \u2014 confirm before proceeding');}\"",
            "if": "Bash(git push*)",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/careful/scripts/check-destructive.js\"",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/review/scripts/check-review-gate.js\"",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-anticheat.js\"",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-eval-first.js\"",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-cd-persistence.js\"",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-read-size.js\"",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-wrap-collision.js\"",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-d-entry-timing.js\"",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-skill-slug.js\"",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/freeze/scripts/check-freeze.js\"",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/memory-size-gate.js\"",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-alignment-gate.js\"",
            "timeout": 2000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/context-wrap-trigger.js\"",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "expo@expo-plugins": false,
    "security-guidance@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "exa@claude-plugins-official": true,
    "compound-engineering@compound-engineering-plugin": true
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "source": "git",
        "url": "https://github.com/EveryInc/compound-engineering-plugin.git"
      }
    },
    "expo-plugins": {
      "source": {
        "source": "github",
        "repo": "expo/skills"
      }
    }
  },
  "outputStyle": "Plain Coach",
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Investigating",
      "Tracing",
      "Auditing",
      "Evaluating"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5[1m]": {
      "effortLevel": "medium"
    },
    "claude-opus-5[1m]": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1[1m]": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "verbose": false,
  "autoCompactEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(railway * --environment production*)",
      "Bash(git push:*)"
    ],
    "hard_deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)"
    ]
  }
}
