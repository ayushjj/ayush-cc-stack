*.pyc
__pycache__/
node_modules/

# Secrets
.env
.env.*
!.env.example
secrets-*
*.pem
*.key

# Release-spec documentation (per decisions.md D8: "NO specs/ folder in the public repo")
# Maintainer-only directory holding the design / decisions / implementation / pre-publish
# checklist for the publish event itself. Contains literal denylist patterns (business
# identifiers used as grep arguments) that must never be tracked.
specs/
